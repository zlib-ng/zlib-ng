CC=
CFLAGS=
SFLAGS=
INCLUDES=
SUFFIX=

MSAFLAG=-mmsa -mhard-float -mfp64 -mnan=2008
NOLTOFLAG=

SRCDIR=.
SRCTOP=../..
TOPDIR=$(SRCTOP)

all: mips_features.o \
     mips_features.lo \
     adler32_msa.o \
     adler32_msa.lo \
     slide_hash_msa.o \
     slide_hash_msa.lo

mips_features.o:
	$(CC) $(CFLAGS) $(INCLUDES) -c -o $@ $(SRCDIR)/mips_features.c

mips_features.lo:
	$(CC) $(SFLAGS) $(INCLUDES) -c -o $@ $(SRCDIR)/mips_features.c

adler32_msa.o:
	$(CC) $(CFLAGS) $(MSAFLAG) $(NOLTOFLAG) $(INCLUDES) -c -o $@ $(SRCDIR)/adler32_msa.c

adler32_msa.lo:
	$(CC) $(SFLAGS) $(MSAFLAG) $(NOLTOFLAG) $(INCLUDES) -c -o $@ $(SRCDIR)/adler32_msa.c

slide_hash_msa.o:
	$(CC) $(CFLAGS) $(MSAFLAG) $(NOLTOFLAG) $(INCLUDES) -c -o $@ $(SRCDIR)/slide_hash_msa.c

slide_hash_msa.lo:
	$(CC) $(SFLAGS) $(MSAFLAG) $(NOLTOFLAG) $(INCLUDES) -c -o $@ $(SRCDIR)/slide_hash_msa.c

mostlyclean: clean
clean:
	rm -f *.o *.lo *~
	rm -rf objs
	rm -f *.gcda *.gcno *.gcov

distclean: clean
	rm -f Makefile
